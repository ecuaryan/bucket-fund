# Copy this file to .env.local and fill in real values for local dev.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# Supabase (client-safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Teller Connect application id (client-safe)
VITE_TELLER_APPLICATION_ID=

# --- Edge Function only ---
# NEVER prefix with VITE_. Set via `supabase secrets set` for deployed
# functions; for local dev set in supabase/functions/.env (gitignored).
TELLER_SIGNING_SECRET=

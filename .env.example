# Copy this file to .env.local and fill in real values for local dev.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
#
# Local Supabase (recommended): npm run db:start && eval "$(npm run env:local)"
# Hosted project: use Dashboard → Settings → API for URL + anon key.

# Supabase (client-safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Teller Connect (client-safe — Connect runs in the browser)
VITE_TELLER_APPLICATION_ID=
VITE_TELLER_ENVIRONMENT=production   # 'sandbox' | 'development' | 'production'

# --- Edge Function only ---
# NEVER prefix with VITE_. For local dev, put these in
# `supabase/functions/.env` (gitignored). For deployed functions, set
# via `supabase secrets set` so they're available at runtime.
TELLER_APPLICATION_ID=
TELLER_ENVIRONMENT=production
TELLER_CERTIFICATE=
TELLER_PRIVATE_KEY=
TELLER_SIGNING_SECRET=
